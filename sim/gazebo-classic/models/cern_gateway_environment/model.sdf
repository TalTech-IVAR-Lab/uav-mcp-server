<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="cern_gateway_environment">
    <static>true</static>
    <allow_auto_disable>true</allow_auto_disable>
    <link name="scene">
      <gravity>false</gravity>
      <kinematic>true</kinematic>
      <visual name="cern_gateway_visual">
        <cast_shadows>true</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://cern_gateway_environment/meshes/cern_gateway_environment.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="cern_gateway_collision">
        <geometry>
          <mesh>
            <uri>model://cern_gateway_environment/meshes/cern_gateway_environment.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100</mu>
              <mu2>50</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100</kd>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
