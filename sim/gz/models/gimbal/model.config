<?xml version="1.0"?>
<model>
  <name>gimbal</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Lightweight override of PX4's `gimbal` model for the TalTech UAV MCP
    simulator. Identical joint names (cgo3_vertical_arm_joint /
    cgo3_horizontal_arm_joint / cgo3_camera_joint), identical sub-topics
    (command/gimbal_yaw|roll|pitch), and identical sensor names
    (camera_imu, camera) so PX4's gimbal driver and our camera bridge keep
    working unchanged. The link masses are dropped to 0.001 kg and the
    camera-ball collision is removed so the gimbal stops behaving as a
    pendulum hanging below the airframe — that pendulum was destabilising
    x500 takeoff. The meshes/ subdir is a symlink to PX4's mesh files;
    visuals are unchanged.
  </description>
  <author>
    <name>thesis-uav</name>
  </author>
</model>
